# ---------------------------------------------------------------------
# Jardin de Gironde
#
# Les règles de domaine ne s'appliquent qu'à jardindegironde.fr : le site
# reste donc consultable tel quel sur une adresse de test.
# ---------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS et www, uniquement sur le domaine réel ---
  RewriteCond %{HTTP_HOST} ^(www\.)?jardindegironde\.fr$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.jardindegironde.fr%{REQUEST_URI} [R=301,L]

  # --- Anciennes adresses de l'ancien site (sans extension) ---
  # /tonte-pelouse -> /tonte-pelouse.html, etc. Redirection permanente :
  # les pages déjà référencées par Google gardent leur ancienneté.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/.]+)/?$ /$1.html [R=301,L]

  # --- Anciens noms de pages qui ont changé ---
  RewriteRule ^entretien-jardin/?$ /entretien-jardin.html [R=301,L]
</IfModule>

# --- Page d'erreur ---
ErrorDocument 404 /index.html

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache navigateur ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType video/mp4              "access plus 1 year"
</IfModule>

# --- En-têtes de sécurité ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|svg|png|mp4|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Les journaux et les demandes ne sont jamais servis ---
<FilesMatch "\.(log|json)$">
  Require all denied
</FilesMatch>
