# ==========================================================================
# BACNIFIQUE — règles de cache
#
# Par défaut l'hébergeur pose max-age=604800 (7 jours) sur le CSS et le JS,
# alors que le HTML, lui, se revalide. Un visiteur récupérait donc le
# nouveau HTML avec l'ancienne feuille de styles, et la page s'affichait
# décomposée. On force ici la revalidation du CSS/JS ; les images et
# polices, elles, gardent un cache long puisqu'elles ne changent jamais
# sans changer de nom.
# ==========================================================================

<IfModule mod_headers.c>
  # HTML : toujours revalider
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS / JS : le navigateur revalide à chaque visite (réponse 304 si inchangé)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Médias : cache long, ils sont versionnés par leur nom de fichier
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
